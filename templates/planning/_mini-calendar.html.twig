<aside class="planning-sidebar">
	<details>
	<span>Heure actuelle</span>
		<summary>
			<i class="fa-regular fa-clock"></i>
			<span>Horloge</span>
		</summary>
	</details>
	<details open>
		<div id="mini-calendar" class="mini-calendar-wrapper">

			<button class="btn btn-today"></button>

			<div class="month-selector">

				<button class="btn btn-previous btn-previous-month">
					&#x2039;
				</button>

				<div class="active-month-label"></div>

				<button class="btn btn-next btn-next-month">
					&#x203A;
				</button>

			</div>

			<div class="mini-calendar-grid"></div>
			<div class="selected-week-label"></div>
		</div>

		<summary>
			<i class="fa-regular fa-calendar"></i>
			<span>Calendrier</span>
		</summary>
	</details>
	<details>
		<summary>
			<i class="fa-solid fa-earth-americas"></i>
			<span>Fuseaux horaires</span>
		</summary>
	</details>
</aside>
