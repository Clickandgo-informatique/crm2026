{# templates/planning/views/_week-view.html.twig #}


<div class="week-view-wrapper">

	<div class="calendar-header">

		<div class="calendar-navigation">

			<button id="previous-week" class="btn btn-previous">
				&#x2039;
			</button>
			<span id="week-label"></span>

			<button id="next-week" class="btn btn-next">
				&#x203A;
			</button>
		</div>

	</div>

	<div class="week-view-content">

		<div class="calendar-grid"></div>

		{% include "planning/_calendar-zoom.html.twig" %}

	</div>

</div>
